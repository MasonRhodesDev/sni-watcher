[Unit]
Description=Standalone StatusNotifierWatcher (system tray registry)
Documentation=https://github.com/MasonRhodesDev/sni-watcher
# Needs only the session bus, so it runs before the graphical session is up:
# every app, the bar and the XDG autostart target then find the name already
# owned. Stops with the session (PartOf), never gates it (no Requisite).
After=dbus.socket
Before=graphical-session-pre.target
PartOf=graphical-session.target
# Belt and braces for units that start in the same transaction.
Before=waybar.service xdg-desktop-autostart.target

[Service]
Type=dbus
BusName=org.kde.StatusNotifierWatcher
ExecStart=/usr/bin/sni-watcher
# The registry is mirrored to $XDG_RUNTIME_DIR/sni-watcher/items and restored
# on start, so a crash comes back with the same list. Come back immediately.
Restart=always
RestartSec=0
# Do not be the kernel's first choice under memory pressure.
OOMScoreAdjust=-900
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session-pre.target
